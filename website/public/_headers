# Response headers for hosts that read a _headers file, such as Cloudflare Pages and Netlify. Both
# compress with Brotli on their own, .wasm included, so no encoding is set here. GitHub Pages, which
# serves sqlquack.io, ignores this file: it serves gzip with a 10-minute cache.

# Content-hashed by Astro: a changed file gets a new name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# DuckDB-WASM, in a directory named for its version: a new version gets a new path.
/playground/duckdb/*
  Cache-Control: public, max-age=31536000, immutable

# The playground engine and pages keep their names across builds, so they revalidate.
/playground/engine/*
  Cache-Control: public, max-age=300, must-revalidate

/fonts/*
  Cache-Control: public, max-age=2592000

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
