Set Shell bash
Set FontFamily "DejaVu Sans Mono"
Set FontSize 17
Set LineHeight 1.1
Set Width 1360
Set Height 680
Set Padding 28
Set Margin 24
Set MarginFill "#0d0f12"
Set BorderRadius 10
Set WindowBar Colorful
Set TypingSpeed 45ms
Set Theme { "name": "SQLQuack", "black": "#626975", "red": "#f47089", "green": "#54cf8e", "yellow": "#ffe000", "blue": "#4f98ee", "magenta": "#a78bfa", "cyan": "#1fe0c0", "white": "#c9cdd4", "brightBlack": "#9ba1ac", "brightRed": "#f47089", "brightGreen": "#54cf8e", "brightYellow": "#fff06a", "brightBlue": "#4f98ee", "brightMagenta": "#c79bf0", "brightCyan": "#1fe0c0", "brightWhite": "#e9ebef", "background": "#111418", "foreground": "#c9cdd4", "selection": "#2a2f37", "cursor": "#e9ebef" }
